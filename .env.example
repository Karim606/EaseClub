# Database Configuration
ConnectionStrings__Dev=Server=YOUR_SERVER;Database=EaseClub;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Logging & Monitoring (BetterStack)
BETTERSTACK_SOURCE_TOKEN=YOUR_BETTERSTACK_SOURCE_TOKEN
BETTERSTACK_INGEST_URL=https://in.logs.betterstack.com

# JWT Authentication Settings
JwtSettings__SecretKey=YOUR_SUPER_SECRET_KEY_MIN_32_CHARS_LONG
JwtSettings__Issuer=EaseClub
JwtSettings__Audience=EaseClubClients
JwtSettings__DurationInMinutes=15
JwtSettings__RefreshTokenExpiryDays=15

# Email Settings (MailTrap / SMTP Provider)
EmailSettings__FromEmail=noreply@easeclub.com
EmailSettings__SmtpServer=sandbox.smtp.mailtrap.io
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=YOUR_SMTP_USERNAME
EmailSettings__SmtpPass=YOUR_SMTP_PASSWORD

# CORS Settings
CORS_ORIGINS=http://localhost:4200

# ImageKit File Storage
ImageKit__PublicKey=YOUR_IMAGEKIT_PUBLIC_KEY
ImageKit__PrivateKey=YOUR_IMAGEKIT_PRIVATE_KEY
ImageKit__UrlEndpoint=https://ik.imagekit.io/YOUR_ENDPOINT

# Firebase Admin SDK Configuration (for Push Notifications)
FireBase__TYPE=service_account
FireBase__PROJECTID=YOUR_FIREBASE_PROJECT_ID
FireBase__PRIVATEKEYID=YOUR_FIREBASE_PRIVATE_KEY_ID
FireBase__PRIVATEKEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FireBase__CLIENTEMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FireBase__CLIENTID=YOUR_FIREBASE_CLIENT_ID
FireBase__AUTHURI=https://accounts.google.com/o/oauth2/auth
FireBase__TOKENURI=https://oauth2.googleapis.com/token

# Geidea Payment Gateway Integration
Geidea__BaseUrl=https://api.merchant.geidea.net/
Geidea__MerchantId=YOUR_GEIDEA_MERCHANT_ID
Geidea__ApiPassword=YOUR_GEIDEA_API_PASSWORD
Geidea__PublicKey=YOUR_GEIDEA_PUBLIC_KEY
Geidea__SuccessUrl=http://localhost:4200/payment/success
Geidea__CallbackUrl=https://YOUR_WEBHOOK_URL/api/v1/payments/webhook
Geidea__Currency=EGP
